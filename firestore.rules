rules_version = '2';

// Ronda do Pomar: regras de segurança do Firestore v2 (empresas, unidades, setores, vínculos).
//
// Princípios
//  1. Nega tudo por padrão. Cada coleção abaixo abre só o que precisa.
//  2. Isolamento por caminho: todo dado de uma empresa fica em empresas/{empresaId}/... e só
//     entra quem tem um documento ativo em empresas/{empresaId}/membros/{uid}.
//  3. O que a pessoa pode fazer vem dos VÍNCULOS por setor (vinculos/{uid}_{setorId}) e do módulo
//     habilitado no setor. Cadastros base (unidades, setores, talhões, safras, ajustes) são legíveis
//     por todo membro ativo; dados operacionais exigem vínculo no setor do recurso.
//  4. O admin da empresa gerencia a estrutura, mas NÃO lê dados operacionais sem vínculo.
//     O admin da plataforma gerencia empresas e catálogo, mas NÃO lê dados das empresas.
//  5. Nada é apagado. Ficha publicada e ajustes de limite são imutáveis (só se acrescenta).
//
// Limites conhecidos (sem Cloud Functions): as regras não percorrem o conteúdo de "obs" das
// plantas, então os valores 0 a 3 de cada quadrante são validados pelo app; não há como exigir
// 30 plantas ao finalizar; a estrutura do catálogo (fichas) é confiada ao admin da plataforma.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade ----------

    function logado() {
      return request.auth != null;
    }

    function ehAdminPlataforma() {
      return logado()
        && exists(/databases/$(database)/documents/plataforma_admins/$(request.auth.uid));
    }

    // ---------- Vínculo com a empresa ----------

    function membroAtivo(e) {
      return logado()
        && exists(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid))
        && get(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid)).data.ativo == true;
    }

    function ehAdmin(e) {
      return membroAtivo(e)
        && get(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid)).data.papelEmpresa == 'admin';
    }

    // Vínculo da pessoa que faz a requisição num setor: documento {uid}_{setorId}.
    function vinculoAtivo(e, sid) {
      return membroAtivo(e)
        && exists(/databases/$(database)/documents/empresas/$(e)/vinculos/$(request.auth.uid + '_' + sid))
        && get(/databases/$(database)/documents/empresas/$(e)/vinculos/$(request.auth.uid + '_' + sid)).data.ativo == true;
    }

    function ehGerente(e, sid) {
      return vinculoAtivo(e, sid)
        && get(/databases/$(database)/documents/empresas/$(e)/vinculos/$(request.auth.uid + '_' + sid)).data.papel == 'gerente';
    }

    function outroMembroAtivo(e, uid) {
      return exists(/databases/$(database)/documents/empresas/$(e)/membros/$(uid))
        && get(/databases/$(database)/documents/empresas/$(e)/membros/$(uid)).data.ativo == true;
    }

    function temFuncao(e, sid, funcao) {
      return vinculoAtivo(e, sid)
        && funcao in get(/databases/$(database)/documents/empresas/$(e)/vinculos/$(request.auth.uid + '_' + sid)).data.funcoes;
    }

    // O setor precisa estar ativo e ter o módulo habilitado.
    function moduloAtivo(e, sid, modulo) {
      return exists(/databases/$(database)/documents/empresas/$(e)/setores/$(sid))
        && get(/databases/$(database)/documents/empresas/$(e)/setores/$(sid)).data.ativo == true
        && modulo in get(/databases/$(database)/documents/empresas/$(e)/setores/$(sid)).data.modulos;
    }

    // ---------- Validações ----------

    function textoAte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Ids que entram em ids compostos não podem ter "_" (evita colisão entre ids).
    function idSemSublinhado(v) {
      return v is string && v.matches('^[A-Za-z0-9-]{1,60}$');
    }

    function membroValido(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'papelEmpresa', 'ativo', 'nome', 'criadoEm'])
        && d.keys().hasAll(['uid', 'papelEmpresa', 'ativo'])
        && d.uid == uid
        && d.papelEmpresa in ['admin', 'membro']
        && d.ativo is bool
        && (!('nome' in d) || textoAte(d.nome, 80));
    }

    function unidadeValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'municipio', 'ativa', 'criadoEm'])
        && d.keys().hasAll(['nome', 'ativa'])
        && textoAte(d.nome, 120)
        && d.ativa is bool
        && (!('municipio' in d) || textoAte(d.municipio, 120));
    }

    // Módulos que o sistema conhece. Módulo novo = mudança nestas regras (de propósito).
    function setorValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['unidadeId', 'nome', 'modulos', 'ativo', 'criadoEm'])
        && d.keys().hasAll(['unidadeId', 'nome', 'modulos', 'ativo'])
        && textoAte(d.unidadeId, 128)
        && textoAte(d.nome, 120)
        && d.modulos is list && d.modulos.size() <= 20 && d.modulos.hasOnly(['fitossanidade', 'frota'])
        && d.ativo is bool;
    }

    function safraValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['culturaId', 'inicio', 'fim', 'ativa', 'criadoEm'])
        && d.keys().hasAll(['culturaId', 'inicio'])
        && textoAte(d.culturaId, 64)
        && d.inicio is string && d.inicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('fim' in d) || (d.fim is string && d.fim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('ativa' in d) || d.ativa is bool);
    }

    function talhaoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['unidadeId', 'nome', 'culturaId', 'variedade', 'areaHa', 'atributos',
                               'ativo', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['unidadeId', 'nome', 'culturaId', 'atributos', 'ativo'])
        && textoAte(d.unidadeId, 128)
        && textoAte(d.nome, 120)
        && textoAte(d.culturaId, 64)
        && d.atributos is map && d.atributos.keys().size() <= 20
        && d.ativo is bool
        && (!('variedade' in d) || textoAte(d.variedade, 80))
        && (!('areaHa' in d) || (d.areaHa is number && d.areaHa > 0));
    }

    // Ajuste de limite: só acrescenta, sempre "a partir de agora" (não dá para voltar no tempo).
    function ajusteValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['culturaId', 'alvoId', 'itemId', 'nivelId', 'limite', 'vigenteDe', 'criadoPor', 'motivo'])
        && d.keys().hasAll(['culturaId', 'limite', 'vigenteDe', 'criadoPor'])
        && textoAte(d.culturaId, 64)
        && ('alvoId' in d || 'itemId' in d)
        && (!('alvoId' in d) || textoAte(d.alvoId, 64))
        && (!('itemId' in d) || textoAte(d.itemId, 64))
        && (!('nivelId' in d) || textoAte(d.nivelId, 64))
        && d.limite is number && d.limite >= 0 && d.limite <= 100
        && d.vigenteDe == request.time
        && d.criadoPor == request.auth.uid
        && (!('motivo' in d) || textoAte(d.motivo, 500));
    }

    // ---------- Frota (maquinário) ----------
    // A máquina é da UNIDADE (como o talhão): setores diferentes da mesma fazenda a compartilham.
    // "usoAtual" (na máquina) e o registro em "usos" são escritos JUNTOS pelo app (mesmo lote, mesmo
    // usoId), mas as regras avaliam cada escrita por si: cruzar as duas com getAfter/existsAfter
    // esbarrou no limite de avaliação do Firestore (regras caras demais). O pior caso de uma escrita
    // sem a outra é um registro sem log, não uma falha de autorização: cada escrita já exige sozinha
    // a função "operador" no setor certo, da mesma unidade da máquina. O mesmo vale para "manutencoes".

    function usoAtualValido(u) {
      return u == null
        || (u.keys().hasOnly(['usoId', 'operadorUid', 'setorId', 'inicioEm'])
            && u.keys().hasAll(['usoId', 'operadorUid', 'setorId', 'inicioEm'])
            && u.usoId is string && u.usoId.size() > 0 && u.usoId.size() <= 60
            && textoAte(u.operadorUid, 128)
            && idSemSublinhado(u.setorId)
            && u.inicioEm is timestamp);
    }

    function maquinaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['unidadeId', 'nome', 'modelo', 'tipo', 'documento', 'ativo',
                               'disponibilidade', 'status', 'combustivel', 'usoAtual', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['unidadeId', 'nome', 'ativo', 'disponibilidade', 'status', 'combustivel'])
        && textoAte(d.unidadeId, 128)
        && textoAte(d.nome, 120)
        && (!('modelo' in d) || textoAte(d.modelo, 120))
        && (!('tipo' in d) || textoAte(d.tipo, 60))
        && (!('documento' in d) || textoAte(d.documento, 200))
        && d.ativo is bool
        && d.disponibilidade in ['disponivel', 'em_uso']
        && d.status in ['operacional', 'precisa_manutencao', 'manutencao_sugerida']
        && d.combustivel is number && d.combustivel >= 0 && d.combustivel <= 1
        && (!('usoAtual' in d) || usoAtualValido(d.usoAtual));
    }

    // Só o admin cadastra, e ela nasce disponível, operacional e ativa (o dia a dia começa depois).
    function maquinaCriavel(e) {
      let d = request.resource.data;
      return maquinaValida()
        && d.disponibilidade == 'disponivel'
        && d.status == 'operacional'
        && d.ativo == true
        && !('usoAtual' in d)
        && exists(/databases/$(database)/documents/empresas/$(e)/unidades/$(d.unidadeId));
    }

    // O admin edita o cadastro (nome, modelo, tipo, documento, ativo); nunca mexe no dia a dia por aqui.
    function maquinaEditavelPeloAdmin() {
      let r = resource.data;
      let d = request.resource.data;
      return maquinaValida()
        && d.unidadeId == r.unidadeId
        && d.disponibilidade == r.disponibilidade
        && d.status == r.status
        && d.combustivel == r.combustivel
        && (('usoAtual' in d) == ('usoAtual' in r))
        && (!('usoAtual' in d) || d.usoAtual == r.usoAtual);
    }

    // Iniciar um uso: só quem tem a função "operador" no setor (do módulo Frota, da MESMA unidade da
    // máquina), com a máquina ativa e disponível. O uso nasce no mesmo lote (mesmo usoId nos dois).
    function usoIniciavel(e, mid) {
      let r = resource.data;
      let d = request.resource.data;
      return d.diff(r).affectedKeys().hasOnly(['disponibilidade', 'usoAtual', 'atualizadoEm'])
        && r.ativo == true
        && r.disponibilidade == 'disponivel'
        && !('usoAtual' in r)
        && d.disponibilidade == 'em_uso'
        && usoAtualValido(d.usoAtual)
        && d.usoAtual.operadorUid == request.auth.uid
        && d.usoAtual.inicioEm == request.time
        && temFuncao(e, d.usoAtual.setorId, 'operador')
        && moduloAtivo(e, d.usoAtual.setorId, 'frota')
        && get(/databases/$(database)/documents/empresas/$(e)/setores/$(d.usoAtual.setorId)).data.unidadeId == r.unidadeId;
    }

    // Encerrar um uso: só quem começou, e o combustível vira o vigente da máquina.
    function usoEncerravel(e, mid) {
      let r = resource.data;
      let d = request.resource.data;
      return d.diff(r).affectedKeys().hasOnly(['disponibilidade', 'usoAtual', 'combustivel', 'atualizadoEm'])
        && r.disponibilidade == 'em_uso'
        && r.usoAtual.operadorUid == request.auth.uid
        && d.disponibilidade == 'disponivel'
        && !('usoAtual' in d)
        && d.combustivel is number && d.combustivel >= 0 && d.combustivel <= 1
        && temFuncao(e, r.usoAtual.setorId, 'operador');
    }

    // Qualquer membro ativo sinaliza um problema leve: só de "operacional" para "manutenção sugerida".
    function manutencaoSugerivel(e) {
      let r = resource.data;
      let d = request.resource.data;
      return membroAtivo(e)
        && d.diff(r).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && r.status == 'operacional'
        && d.status == 'manutencao_sugerida';
    }

    // Só o admin marca urgente (de qualquer estado, menos já urgente) ou conclui (volta a operacional).
    function manutencaoAlteravelPeloAdmin() {
      let r = resource.data;
      let d = request.resource.data;
      return d.diff(r).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && ((d.status == 'precisa_manutencao' && r.status != 'precisa_manutencao')
            || (d.status == 'operacional' && r.status != 'operacional'));
    }

    // Registro do uso: nasce com o mesmo id que a máquina referencia em "usoAtual.usoId".
    function usoCriavel(e, mid) {
      let d = request.resource.data;
      let m = get(/databases/$(database)/documents/empresas/$(e)/maquinas/$(mid)).data;
      return d.keys().hasOnly(['operadorUid', 'setorId', 'unidadeId', 'inicioEm', 'fimEm', 'combustivelInicio', 'combustivelFim'])
        && d.keys().hasAll(['operadorUid', 'setorId', 'unidadeId', 'inicioEm'])
        && d.operadorUid == request.auth.uid
        && idSemSublinhado(d.setorId)
        && d.unidadeId == m.unidadeId
        && d.inicioEm == request.time
        && !('fimEm' in d)
        && (!('combustivelInicio' in d) || (d.combustivelInicio is number && d.combustivelInicio >= 0 && d.combustivelInicio <= 1))
        && temFuncao(e, d.setorId, 'operador')
        && moduloAtivo(e, d.setorId, 'frota')
        && get(/databases/$(database)/documents/empresas/$(e)/setores/$(d.setorId)).data.unidadeId == m.unidadeId;
    }

    // Fechar o registro do uso: só quem começou, com o fim e o combustível; a máquina tem que ter voltado a "disponível".
    function usoFechavel(e, mid) {
      let r = resource.data;
      let d = request.resource.data;
      return d.diff(r).affectedKeys().hasOnly(['fimEm', 'combustivelFim'])
        && r.operadorUid == request.auth.uid
        && !('fimEm' in r)
        && d.fimEm == request.time
        && d.combustivelFim is number && d.combustivelFim >= 0 && d.combustivelFim <= 1;
    }

    // Registro de manutenção: log, só acrescenta (quem grava é sempre quem está autenticado).
    function manutencaoCriavel() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'descricao', 'criadoPor', 'criadoEm'])
        && d.keys().hasAll(['tipo', 'criadoPor', 'criadoEm'])
        && d.tipo in ['sugestao', 'realizada']
        && d.criadoPor == request.auth.uid
        && d.criadoEm == request.time
        && (!('descricao' in d) || textoAte(d.descricao, 1000));
    }

    function vinculoCamposValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pessoaUid', 'setorId', 'unidadeId', 'papel', 'funcoes', 'ativo', 'versao', 'alteradoPor', 'alteradoEm'])
        && d.keys().hasAll(['pessoaUid', 'setorId', 'unidadeId', 'papel', 'funcoes', 'ativo', 'versao', 'alteradoPor', 'alteradoEm'])
        && textoAte(d.pessoaUid, 128)
        && idSemSublinhado(d.setorId)
        && textoAte(d.unidadeId, 128)
        && d.papel in ['gerente', 'funcionario']
        && d.funcoes is list && d.funcoes.size() <= 4 && d.funcoes.hasOnly(['pragueiro', 'agronomo', 'operador'])
        && d.ativo is bool
        && d.versao is int;
    }

    // Criar vínculo: o admin da empresa cria qualquer um (inclusive para si, para poder operar);
    // o gerente do setor cria só FUNCIONÁRIO, no próprio setor, nunca para si. A pessoa precisa ser
    // membro ativo. Todo vínculo nasce com a versão 1 e o registro de histórico no MESMO lote.
    function vinculoCriavel(e, vid) {
      let d = request.resource.data;
      return vinculoCamposValidos()
        && vid == d.pessoaUid + '_' + d.setorId
        && d.versao == 1
        && d.alteradoPor == request.auth.uid
        && d.alteradoEm == request.time
        && get(/databases/$(database)/documents/empresas/$(e)/setores/$(d.setorId)).data.unidadeId == d.unidadeId
        && outroMembroAtivo(e, d.pessoaUid)
        && existsAfter(/databases/$(database)/documents/empresas/$(e)/vinculos/$(vid)/historico/$(d.versao))
        && (ehAdmin(e)
            || (ehGerente(e, d.setorId) && d.papel == 'funcionario' && d.pessoaUid != request.auth.uid));
    }

    // Alterar vínculo: só ativo, funcoes, papel e auditoria; a versão sobe 1 e o histórico é gravado
    // junto. O admin altera qualquer um (só ele promove a gerente). O gerente altera só FUNCIONÁRIO do
    // próprio setor: não promove, não mexe em outro gerente e não mexe em si mesmo.
    function vinculoAtualizavel(e, vid) {
      let d = request.resource.data;
      let r = resource.data;
      return vinculoCamposValidos()
        && d.diff(r).affectedKeys().hasOnly(['ativo', 'funcoes', 'papel', 'versao', 'alteradoPor', 'alteradoEm'])
        && d.versao == r.versao + 1
        && d.alteradoPor == request.auth.uid
        && d.alteradoEm == request.time
        && existsAfter(/databases/$(database)/documents/empresas/$(e)/vinculos/$(vid)/historico/$(d.versao))
        && (ehAdmin(e)
            || (ehGerente(e, r.setorId)
                && r.papel == 'funcionario' && d.papel == 'funcionario'
                && r.pessoaUid != request.auth.uid));
    }

    // Registro de histórico: cópia fiel do vínculo DEPOIS da alteração (getAfter), no mesmo lote.
    function historicoCriavel(e, vid, hv) {
      let d = request.resource.data;
      let v = getAfter(/databases/$(database)/documents/empresas/$(e)/vinculos/$(vid)).data;
      return d.keys().hasOnly(['versao', 'pessoaUid', 'setorId', 'papel', 'funcoes', 'ativo', 'alteradoPor', 'alteradoEm'])
        && d.keys().hasAll(['versao', 'pessoaUid', 'setorId', 'papel', 'funcoes', 'ativo', 'alteradoPor', 'alteradoEm'])
        && hv.matches('^[0-9]{1,6}$')
        && d.versao == v.versao
        && d.pessoaUid == v.pessoaUid
        && d.setorId == v.setorId
        && d.papel == v.papel
        && d.funcoes == v.funcoes
        && d.ativo == v.ativo
        && d.alteradoPor == request.auth.uid
        && d.alteradoEm == request.time
        && (ehAdmin(e) || ehGerente(e, v.setorId));
    }

    // Avaliação semanal (cabeçalho). Só quem tem a função "pragueiro" no setor cria, e a ficha é a
    // VIGENTE da cultura do talhão (o pragueiro não escolhe versão). Os atributos do talhão são
    // copiados e conferidos, para o limite usado no cálculo não poder ser adulterado.
    function avaliacaoCriavel(e, aid) {
      let d = request.resource.data;
      let t = get(/databases/$(database)/documents/empresas/$(e)/talhoes/$(d.talhaoId)).data;
      let c = get(/databases/$(database)/documents/catalogo_culturas/$(t.culturaId)).data;
      let s = get(/databases/$(database)/documents/empresas/$(e)/setores/$(d.setorId)).data;
      return d.keys().hasOnly(['talhaoId', 'unidadeId', 'setorId', 'safraId', 'fichaId', 'fichaVersao', 'atributosTalhao',
                               'responsavelUid', 'data', 'semanaISO', 'faseCultura', 'status', 'finalizadaEm', 'notas',
                               'outrasPragas', 'armadilha', 'horaInicio', 'horaFim', 'geo', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['talhaoId', 'unidadeId', 'setorId', 'fichaId', 'fichaVersao', 'atributosTalhao',
                            'responsavelUid', 'data', 'semanaISO', 'status'])
        && idSemSublinhado(d.talhaoId)
        && idSemSublinhado(d.setorId)
        && textoAte(d.unidadeId, 128)
        && d.semanaISO is string && d.semanaISO.matches('^[0-9]{4}-W[0-9]{2}$')
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && aid == d.talhaoId + '_' + d.semanaISO + '_' + request.auth.uid
        && d.responsavelUid == request.auth.uid
        && d.status == 'rascunho'
        && !('finalizadaEm' in d)
        && t.ativo == true
        && t.unidadeId == d.unidadeId
        && s.unidadeId == d.unidadeId
        && d.atributosTalhao == t.atributos
        && d.fichaId == c.fichaAtual.fichaId
        && d.fichaVersao == c.fichaAtual.versao
        && (!('safraId' in d) || textoAte(d.safraId, 128))
        && (!('faseCultura' in d) || (d.faseCultura is list && d.faseCultura.size() <= 20))
        && (!('notas' in d) || textoAte(d.notas, 2000))
        && (!('outrasPragas' in d) || textoAte(d.outrasPragas, 2000))
        && temFuncao(e, d.setorId, 'pragueiro')
        && moduloAtivo(e, d.setorId, 'fitossanidade');
    }

    // Decisão: o agrônomo do setor decide UMA vez por avaliação finalizada (id = id da avaliação).
    function decisaoCriavel(e, did) {
      let d = request.resource.data;
      let av = get(/databases/$(database)/documents/empresas/$(e)/avaliacoes/$(did)).data;
      return d.keys().hasOnly(['avaliacaoId', 'talhaoId', 'unidadeId', 'setorId', 'tds', 'motivos', 'status',
                               'decididoPor', 'decididoEm', 'observacao'])
        && d.keys().hasAll(['avaliacaoId', 'talhaoId', 'unidadeId', 'setorId', 'tds', 'status', 'decididoPor', 'decididoEm'])
        && d.avaliacaoId == did
        && av.status == 'finalizada'
        && av.setorId == d.setorId
        && av.talhaoId == d.talhaoId
        && av.unidadeId == d.unidadeId
        && d.status in ['aprovada', 'rejeitada']
        && d.decididoPor == request.auth.uid
        && d.decididoEm == request.time
        && d.tds is list && d.tds.size() >= 1 && d.tds.size() <= 8
        && (!('observacao' in d) || textoAte(d.observacao, 1000))
        && temFuncao(e, d.setorId, 'agronomo')
        && moduloAtivo(e, d.setorId, 'fitossanidade');
    }

    // ---------- Plataforma e catálogo ----------

    // Criado à mão no console; o cliente nunca escreve aqui.
    match /plataforma_admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Perfil mínimo: só o nome. O papel NÃO fica aqui.
    match /users/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome'])
        && textoAte(request.resource.data.nome, 80);
      allow delete: if false;
    }

    // Catálogo (dados versionados da cultura): qualquer autenticado lê; só a plataforma publica.
    match /catalogo_culturas/{id} {
      allow read: if logado();
      allow write: if ehAdminPlataforma();
    }

    match /catalogo_alvos/{id} {
      allow read: if logado();
      allow write: if ehAdminPlataforma();
    }

    // Ficha publicada é IMUTÁVEL: versão nova = documento novo.
    match /catalogo_fichas/{fid}/versoes/{v} {
      allow read: if logado();
      allow create: if ehAdminPlataforma() && v.matches('^[0-9]{1,4}$');
      allow update, delete: if false;
    }

    // O app descobre as empresas do usuário consultando "membros" (grupo de coleções),
    // sempre filtrando por uid == request.auth.uid.
    match /{path=**}/membros/{m} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
    }

    // O app descobre os setores do usuário consultando "vinculos" (grupo de coleções),
    // sempre filtrando por pessoaUid == request.auth.uid.
    match /{path=**}/vinculos/{v} {
      allow read: if logado() && resource.data.pessoaUid == request.auth.uid;
    }

    // ---------- Empresa ----------

    match /empresas/{e} {
      allow read: if membroAtivo(e) || ehAdminPlataforma();
      allow create, update: if ehAdminPlataforma()
        && request.resource.data.keys().hasOnly(['nome', 'status', 'configuracoes', 'criadoEm'])
        && textoAte(request.resource.data.nome, 120);
      allow delete: if false;

      // Quem é da empresa. O papel na empresa é só admin ou membro; o que cada um faz vem dos vínculos.
      match /membros/{uid} {
        allow get: if logado()
          && (request.auth.uid == uid || ehAdmin(e) || ehAdminPlataforma());
        allow list: if ehAdmin(e) || ehAdminPlataforma();

        allow create: if (ehAdmin(e) || ehAdminPlataforma()) && membroValido(uid);

        // Ninguém edita o próprio registro (impede subir o próprio papel). Desativar = ativo:false.
        allow update: if ((ehAdmin(e) && request.auth.uid != uid) || ehAdminPlataforma())
          && membroValido(uid)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if false;
      }

      // Cadastros base: todo membro ativo lê; só o admin da empresa escreve.
      match /unidades/{uni} {
        allow read: if membroAtivo(e);
        allow create, update: if ehAdmin(e) && unidadeValida();
        allow delete: if false;
      }

      match /setores/{sid} {
        allow read: if membroAtivo(e);
        allow create: if ehAdmin(e)
          && idSemSublinhado(sid)
          && setorValido()
          && exists(/databases/$(database)/documents/empresas/$(e)/unidades/$(request.resource.data.unidadeId));
        allow update: if ehAdmin(e)
          && setorValido()
          && request.resource.data.unidadeId == resource.data.unidadeId;
        allow delete: if false;
      }

      match /safras/{sfid} {
        allow read: if membroAtivo(e);
        allow create, update: if ehAdmin(e)
          && safraValida()
          && exists(/databases/$(database)/documents/catalogo_culturas/$(request.resource.data.culturaId));
        allow delete: if false;
      }

      match /talhoes/{tid} {
        allow read: if membroAtivo(e);
        allow create: if ehAdmin(e)
          && idSemSublinhado(tid)
          && talhaoValido()
          && exists(/databases/$(database)/documents/empresas/$(e)/unidades/$(request.resource.data.unidadeId))
          && exists(/databases/$(database)/documents/catalogo_culturas/$(request.resource.data.culturaId));
        allow update: if ehAdmin(e)
          && talhaoValido()
          && request.resource.data.unidadeId == resource.data.unidadeId
          && exists(/databases/$(database)/documents/catalogo_culturas/$(request.resource.data.culturaId));
        allow delete: if false;
      }

      // Vínculo da pessoa com um setor: papel (gerente|funcionario) e funções do módulo.
      // Nunca se apaga; desativar = ativo:false (com histórico).
      match /vinculos/{vid} {
        allow get, list: if logado()
          && (resource.data.pessoaUid == request.auth.uid
              || ehGerente(e, resource.data.setorId)
              || ehAdmin(e));
        allow create: if vinculoCriavel(e, vid);
        allow update: if vinculoAtualizavel(e, vid);
        allow delete: if false;

        match /historico/{hv} {
          allow read: if ehAdmin(e) || ehGerente(e, resource.data.setorId);
          allow create: if historicoCriavel(e, vid, hv);
          allow update, delete: if false;
        }
      }

      // Avaliação semanal. O id é {talhaoId}_{semanaISO}_{uid}: uma por pragueiro, talhão e semana, e a
      // criação offline é idempotente. Consultas do pragueiro filtram por setorId e responsavelUid.
      match /avaliacoes/{aid} {
        allow read: if moduloAtivo(e, resource.data.setorId, 'fitossanidade')
          && ((temFuncao(e, resource.data.setorId, 'pragueiro') && resource.data.responsavelUid == request.auth.uid)
              || ehGerente(e, resource.data.setorId)
              || temFuncao(e, resource.data.setorId, 'agronomo'));

        allow create: if avaliacaoCriavel(e, aid);

        // Só o dono, só em rascunho. Identidade, talhão, setor, semana, ficha e atributos não mudam
        // (não estão na lista de campos editáveis). Finalizar carimba a hora do servidor.
        allow update: if temFuncao(e, resource.data.setorId, 'pragueiro')
          && moduloAtivo(e, resource.data.setorId, 'fitossanidade')
          && resource.data.responsavelUid == request.auth.uid
          && resource.data.status == 'rascunho'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['faseCultura', 'notas', 'outrasPragas', 'armadilha', 'horaInicio', 'horaFim', 'geo',
                'status', 'atualizadoEm', 'finalizadaEm'])
          && ((request.resource.data.status == 'rascunho' && !('finalizadaEm' in request.resource.data))
              || (request.resource.data.status == 'finalizada' && request.resource.data.finalizadaEm == request.time))
          && (!('faseCultura' in request.resource.data)
              || (request.resource.data.faseCultura is list && request.resource.data.faseCultura.size() <= 20))
          && (!('notas' in request.resource.data) || textoAte(request.resource.data.notas, 2000))
          && (!('outrasPragas' in request.resource.data) || textoAte(request.resource.data.outrasPragas, 2000));

        allow delete: if false;

        // Uma planta por documento (1 a 30). Não crie o pai e as plantas no mesmo lote:
        // get() enxerga o estado anterior ao lote.
        match /plantas/{n} {
          function pai() {
            return get(/databases/$(database)/documents/empresas/$(e)/avaliacoes/$(aid)).data;
          }

          allow read: if moduloAtivo(e, pai().setorId, 'fitossanidade')
            && ((temFuncao(e, pai().setorId, 'pragueiro') && pai().responsavelUid == request.auth.uid)
                || ehGerente(e, pai().setorId)
                || temFuncao(e, pai().setorId, 'agronomo'));

          allow create, update: if temFuncao(e, pai().setorId, 'pragueiro')
            && moduloAtivo(e, pai().setorId, 'fitossanidade')
            && pai().responsavelUid == request.auth.uid
            && pai().status == 'rascunho'
            && n.matches('^([1-9]|[12][0-9]|30)$')
            && request.resource.data.keys().hasOnly(['n', 'obs', 'fotos', 'notas', 'atualizadoEm'])
            && request.resource.data.keys().hasAll(['n', 'obs'])
            && request.resource.data.n is int
            && request.resource.data.obs is map && request.resource.data.obs.keys().size() <= 60
            && (!('fotos' in request.resource.data)
                || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 20))
            && (!('notas' in request.resource.data) || textoAte(request.resource.data.notas, 1000));

          allow delete: if false;
        }
      }

      // Decisão: o agrônomo decide; o gerente do setor só marca como executada. Nada se apaga.
      match /decisoes/{did} {
        allow read: if moduloAtivo(e, resource.data.setorId, 'fitossanidade')
          && (ehGerente(e, resource.data.setorId) || temFuncao(e, resource.data.setorId, 'agronomo'));
        allow create: if decisaoCriavel(e, did);
        allow update: if ehGerente(e, resource.data.setorId)
          && moduloAtivo(e, resource.data.setorId, 'fitossanidade')
          && resource.data.status == 'aprovada'
          && request.resource.data.status == 'executada'
          && request.resource.data.executadoPor == request.auth.uid
          && request.resource.data.executadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'executadoPor', 'executadoEm', 'observacaoExecucao'])
          && (!('observacaoExecucao' in request.resource.data) || textoAte(request.resource.data.observacaoExecucao, 1000));
        allow delete: if false;
      }

      // Trilha de auditoria: só acrescenta. Cada um registra apenas o que ele mesmo fez.
      match /eventos/{id} {
        allow create: if membroAtivo(e)
          && request.resource.data.keys().hasOnly(['uid', 'acao', 'alvo', 'setorId', 'em', 'detalhe'])
          && request.resource.data.keys().hasAll(['uid', 'acao', 'em'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time
          && textoAte(request.resource.data.acao, 40)
          && (!('alvo' in request.resource.data) || textoAte(request.resource.data.alvo, 200))
          && (!('detalhe' in request.resource.data) || textoAte(request.resource.data.detalhe, 500))
          && (!('setorId' in request.resource.data) || idSemSublinhado(request.resource.data.setorId));
        allow read: if ehAdmin(e)
          || (resource.data.setorId is string
              && (ehGerente(e, resource.data.setorId) || temFuncao(e, resource.data.setorId, 'agronomo')));
        allow update, delete: if false;
      }

      match /ajustes/{ajid} {
        allow read: if membroAtivo(e);
        allow create: if ehAdmin(e) && ajusteValido();
        allow update, delete: if false;
      }

      // Maquinário (módulo Frota). Cadastro legível por todo membro ativo, como talhão; o dia a dia
      // (uso e manutenção) exige a função "operador" no setor certo, ou é reservado ao admin.
      match /maquinas/{mid} {
        allow read: if membroAtivo(e);
        allow create: if ehAdmin(e) && maquinaCriavel(e);
        allow update: if (ehAdmin(e) && (maquinaEditavelPeloAdmin() || manutencaoAlteravelPeloAdmin()))
          || usoIniciavel(e, mid)
          || usoEncerravel(e, mid)
          || manutencaoSugerivel(e);
        allow delete: if false;

        // Histórico de uso: quem operou lê o próprio; o gerente do setor lê o do seu setor.
        match /usos/{usoId} {
          allow read: if moduloAtivo(e, resource.data.setorId, 'frota')
            && (resource.data.operadorUid == request.auth.uid || ehGerente(e, resource.data.setorId));
          allow create: if usoCriavel(e, mid);
          allow update: if usoFechavel(e, mid);
          allow delete: if false;
        }

        // Histórico de manutenção: legível por todo membro ativo (baixo risco, mesma régua do cadastro).
        match /manutencoes/{mnid} {
          allow read: if membroAtivo(e);
          allow create: if membroAtivo(e) && manutencaoCriavel();
          allow update, delete: if false;
        }
      }
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
