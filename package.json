{
  "name": "ronda-do-pomar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitoramento semanal de pragas e doenças do limão Tahiti (PWA offline + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cultura \"node --test test/rules/*.test.js\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-cultura",
    "test:rules:proposta": "firebase emulators:exec --only firestore --project demo-ronda \"node --test test/rules-multiempresa/*.test.js\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
