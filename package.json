{
  "name": "ronda-do-pomar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitoramento semanal de pragas e doenças do limão Tahiti (PWA offline + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-ronda \"node --test test/rules/*.test.js\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-ronda",
    "dev:emulador": "vite --mode emulador --port 5174 --host",
    "semear": "node scripts/semear-emulador.mjs",
    "verificar:fluxo": "node scripts/verificar-fluxo-emulador.mjs",
    "test:fluxo": "firebase emulators:exec --only auth,firestore --project demo-ronda \"npm run semear && npm run verificar:sessao && npm run verificar:fluxo && npm run verificar:campo && npm run verificar:gestao && npm run verificar:admin && npm run verificar:frota\"",
    "verificar:sessao": "node scripts/verificar-sessao-emulador.mjs",
    "test:migracao": "firebase emulators:exec --only auth,firestore --project demo-ronda \"node scripts/verificar-migracao-emulador.mjs\"",
    "verificar:campo": "node scripts/verificar-campo-emulador.mjs",
    "verificar:gestao": "node scripts/verificar-gestao-emulador.mjs",
    "verificar:admin": "node scripts/verificar-admin-emulador.mjs",
    "verificar:frota": "node scripts/verificar-frota-emulador.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
