rules_version = '2';

// Ronda do Pomar: regras de segurança do Firestore (multiempresa).
//
// Princípios
//  1. Nega tudo por padrão. Cada coleção abaixo abre só o que precisa.
//  2. Isolamento por caminho: todo dado de uma empresa fica em empresas/{empresaId}/...
//     e só entra quem tem um documento ativo em empresas/{empresaId}/membros/{uid}.
//  3. O papel vive em membros, nunca no perfil do usuário. Ninguém altera o próprio vínculo.
//  4. Papéis por empresa: pragueiro | agronomo | gerente | admin_empresa.
//     Escopo por fazenda: fazendaIds do membro ('*' = todas da empresa).
//  5. O admin da plataforma (plataforma_admins/{uid}) gerencia empresas, vínculos e protocolos,
//     mas NÃO lê avaliações nem decisões de nenhuma empresa.
//  6. Avaliação finalizada é imutável; nada é apagado; decisões e eventos são trilha de auditoria.
//
// Limites conhecidos (sem Cloud Functions): as regras não iteram sobre o conteúdo de "obs" das
// plantas, então os valores 0 a 3 de cada quadrante são validados pelo app; o agrônomo lê os dados
// brutos. Não há como exigir 30 plantas ao finalizar. Ver docs/arquitetura.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identidade ----------

    function logado() {
      return request.auth != null;
    }

    function ehAdminPlataforma() {
      return logado()
        && exists(/databases/$(database)/documents/plataforma_admins/$(request.auth.uid));
    }

    // ---------- Vínculo com a empresa ----------

    function ehMembro(e) {
      return logado()
        && exists(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid))
        && get(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid)).data.ativo == true;
    }

    function dadosMembro(e) {
      return get(/databases/$(database)/documents/empresas/$(e)/membros/$(request.auth.uid)).data;
    }

    function temPapel(e, lista) {
      return ehMembro(e) && dadosMembro(e).papel in lista;
    }

    function veFazenda(e, fid) {
      return ehMembro(e)
        && ('*' in dadosMembro(e).fazendaIds || fid in dadosMembro(e).fazendaIds);
    }

    function ehAdminEmpresa(e) {
      return temPapel(e, ['admin_empresa']);
    }

    // Quem acompanha e decide: enxerga os dados das fazendas do seu escopo.
    function gestaoVe(e, fid) {
      return temPapel(e, ['agronomo', 'gerente', 'admin_empresa']) && veFazenda(e, fid);
    }

    // ---------- Validações ----------

    function textoAte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function papelValido(p) {
      return p in ['pragueiro', 'agronomo', 'gerente', 'admin_empresa'];
    }

    function membroValido(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'papel', 'fazendaIds', 'ativo', 'nome', 'conviteId', 'criadoEm'])
        && d.keys().hasAll(['uid', 'papel', 'fazendaIds', 'ativo'])
        && d.uid == uid
        && papelValido(d.papel)
        && d.fazendaIds is list && d.fazendaIds.size() <= 50
        && d.ativo is bool;
    }

    // O convidado cria o próprio vínculo, mas só nos termos do convite: mesmo e-mail (verificado),
    // mesmo papel e mesmas fazendas, convite válido e ainda não usado. O convite tem que ser
    // marcado como usado no MESMO lote (getAfter), o que impede reaproveitá-lo.
    function aceitaConvite(e, uid) {
      let d = request.resource.data;
      let cpath = /databases/$(database)/documents/empresas/$(e)/convites/$(d.conviteId);
      let c = get(cpath).data;
      return logado() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && d.conviteId is string
        && c.email == request.auth.token.email.lower()
        && c.usadoPor == null
        && c.expiraEm > request.time
        && d.papel == c.papel
        && d.fazendaIds == c.fazendaIds
        && d.ativo == true
        && getAfter(cpath).data.usadoPor == request.auth.uid;
    }

    function talhaoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fazendaId', 'gleba', 'nome', 'areaHa', 'culturaId', 'protocolo',
                               'tipoPomar', 'citrosVizinhos', 'overrides', 'ativo', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['fazendaId', 'nome', 'culturaId', 'protocolo'])
        && textoAte(d.fazendaId, 128)
        && textoAte(d.nome, 120)
        && textoAte(d.culturaId, 64)
        && d.protocolo is map && d.protocolo.keys().hasOnly(['id', 'versao'])
        && (!('areaHa' in d) || (d.areaHa is number && d.areaHa > 0))
        && (!('overrides' in d) || d.overrides is map);
    }

    function avaliacaoCriavel() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fazendaId', 'talhaoId', 'semanaISO', 'data', 'responsavelUid', 'status',
                               'protocolo', 'faseCultura', 'notas', 'outrasPragas', 'armadilha',
                               'horaInicio', 'horaFim', 'geo', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['fazendaId', 'talhaoId', 'semanaISO', 'data', 'responsavelUid', 'status', 'protocolo'])
        && textoAte(d.fazendaId, 128)
        && textoAte(d.talhaoId, 128)
        && d.semanaISO is string && d.semanaISO.matches('^[0-9]{4}-W[0-9]{2}$')
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.protocolo is map && d.protocolo.keys().hasOnly(['id', 'versao'])
        && (!('faseCultura' in d) || (d.faseCultura is list && d.faseCultura.size() <= 20))
        && (!('notas' in d) || textoAte(d.notas, 2000))
        && (!('outrasPragas' in d) || textoAte(d.outrasPragas, 2000));
    }

    function decisaoCriavel(e, did) {
      let d = request.resource.data;
      let av = get(/databases/$(database)/documents/empresas/$(e)/avaliacoes/$(did)).data;
      return d.keys().hasOnly(['avaliacaoId', 'talhaoId', 'fazendaId', 'tds', 'motivos', 'status',
                               'decididoPor', 'decididoEm', 'observacao'])
        && d.keys().hasAll(['avaliacaoId', 'talhaoId', 'fazendaId', 'tds', 'status', 'decididoPor', 'decididoEm'])
        && d.avaliacaoId == did
        && av.status == 'finalizada'
        && av.fazendaId == d.fazendaId
        && av.talhaoId == d.talhaoId
        && veFazenda(e, d.fazendaId)
        && d.status in ['aprovada', 'rejeitada']
        && d.decididoPor == request.auth.uid
        && d.decididoEm == request.time
        && d.tds is list && d.tds.size() >= 1 && d.tds.size() <= 8
        && (!('observacao' in d) || textoAte(d.observacao, 1000));
    }

    // ---------- Plataforma ----------

    // Criado à mão no console; o cliente nunca escreve aqui.
    match /plataforma_admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Modelos de ficha (protocolos) compartilhados. Só o admin da plataforma publica.
    match /protocolos/{pid} {
      allow read: if logado();
      allow write: if ehAdminPlataforma();

      match /versoes/{v} {
        allow read: if logado();
        allow write: if ehAdminPlataforma();
      }
    }

    // Perfil mínimo: só o nome. O papel NÃO fica aqui.
    match /users/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome'])
        && textoAte(request.resource.data.nome, 80);
      allow delete: if false;
    }

    // O app descobre as empresas do usuário consultando "membros" (grupo de coleções),
    // sempre filtrando por uid == request.auth.uid.
    match /{path=**}/membros/{m} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
    }

    // ---------- Empresa ----------

    match /empresas/{e} {
      allow read: if ehMembro(e) || ehAdminPlataforma();
      allow create, update: if ehAdminPlataforma()
        && request.resource.data.keys().hasOnly(['nome', 'status', 'plano', 'criadoEm'])
        && textoAte(request.resource.data.nome, 120);
      allow delete: if false;

      // Vínculo do usuário com a empresa: papel, fazendas e situação.
      match /membros/{uid} {
        allow get: if logado()
          && (request.auth.uid == uid || ehAdminEmpresa(e) || ehAdminPlataforma());
        allow list: if ehAdminEmpresa(e) || ehAdminPlataforma();

        allow create: if ((ehAdminEmpresa(e) || ehAdminPlataforma()) && membroValido(uid))
          || (membroValido(uid) && aceitaConvite(e, uid));

        // Ninguém edita o próprio vínculo (impede subir o próprio papel). Desativar = ativo:false.
        allow update: if ((ehAdminEmpresa(e) && request.auth.uid != uid) || ehAdminPlataforma())
          && membroValido(uid)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if false;
      }

      // Convites: código longo e imprevisível; só vale para o e-mail convidado.
      match /convites/{cid} {
        allow get: if logado()
          && (ehAdminEmpresa(e) || ehAdminPlataforma()
              || (request.auth.token.email_verified == true
                  && resource.data.email == request.auth.token.email.lower()));
        allow list: if ehAdminEmpresa(e) || ehAdminPlataforma();

        allow create: if (ehAdminEmpresa(e) || ehAdminPlataforma())
          && request.resource.data.keys().hasOnly(['email', 'papel', 'fazendaIds', 'expiraEm', 'usadoPor', 'usadoEm', 'criadoPor'])
          && request.resource.data.keys().hasAll(['email', 'papel', 'fazendaIds', 'expiraEm', 'usadoPor', 'criadoPor'])
          && cid.size() >= 20
          && textoAte(request.resource.data.email, 200)
          && request.resource.data.email == request.resource.data.email.lower()
          && papelValido(request.resource.data.papel)
          && request.resource.data.fazendaIds is list && request.resource.data.fazendaIds.size() <= 50
          && request.resource.data.expiraEm is timestamp && request.resource.data.expiraEm > request.time
          && request.resource.data.usadoPor == null
          && request.resource.data.criadoPor == request.auth.uid;

        allow update: if
          // o convidado marca como usado
          (logado() && request.auth.token.email_verified == true
            && resource.data.usadoPor == null
            && resource.data.email == request.auth.token.email.lower()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor', 'usadoEm'])
            && request.resource.data.usadoPor == request.auth.uid
            && request.resource.data.usadoEm == request.time)
          // o admin revoga ou renova (só a validade)
          || ((ehAdminEmpresa(e) || ehAdminPlataforma())
            && resource.data.usadoPor == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraEm']));
        allow delete: if false;
      }

      match /fazendas/{fid} {
        allow read: if veFazenda(e, fid);
        allow create, update: if ehAdminEmpresa(e)
          && request.resource.data.keys().hasOnly(['nome', 'ativa', 'criadoEm'])
          && textoAte(request.resource.data.nome, 120);
        allow delete: if false;
      }

      match /talhoes/{tid} {
        allow read: if veFazenda(e, resource.data.fazendaId);
        allow create: if ehAdminEmpresa(e)
          && veFazenda(e, request.resource.data.fazendaId)
          && talhaoValido();
        allow update: if ehAdminEmpresa(e)
          && veFazenda(e, resource.data.fazendaId)
          && talhaoValido()
          && request.resource.data.fazendaId == resource.data.fazendaId;
        allow delete: if false;
      }

      // Avaliação semanal (cabeçalho). O id é {talhaoId}_{semanaISO}_{uid}: uma por pragueiro,
      // talhão e semana, e a criação offline é idempotente.
      match /avaliacoes/{aid} {
        allow read: if ehMembro(e)
          && ((dadosMembro(e).papel == 'pragueiro' && resource.data.responsavelUid == request.auth.uid)
              || gestaoVe(e, resource.data.fazendaId));

        allow create: if temPapel(e, ['pragueiro'])
          && request.resource.data.responsavelUid == request.auth.uid
          && request.resource.data.status == 'rascunho'
          && veFazenda(e, request.resource.data.fazendaId)
          && avaliacaoCriavel()
          && aid == request.resource.data.talhaoId + '_' + request.resource.data.semanaISO + '_' + request.auth.uid
          && get(/databases/$(database)/documents/empresas/$(e)/talhoes/$(request.resource.data.talhaoId)).data.fazendaId
               == request.resource.data.fazendaId
          && get(/databases/$(database)/documents/empresas/$(e)/talhoes/$(request.resource.data.talhaoId)).data.protocolo
               == request.resource.data.protocolo;

        // Só o dono, só em rascunho. Identidade, talhão, semana e protocolo não mudam
        // (não estão na lista de campos editáveis).
        allow update: if temPapel(e, ['pragueiro'])
          && resource.data.responsavelUid == request.auth.uid
          && resource.data.status == 'rascunho'
          && request.resource.data.status in ['rascunho', 'finalizada']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['faseCultura', 'notas', 'outrasPragas', 'armadilha', 'horaInicio', 'horaFim', 'geo',
                'status', 'atualizadoEm', 'finalizadaEm'])
          && (request.resource.data.status == 'rascunho' || request.resource.data.finalizadaEm == request.time)
          && (!('notas' in request.resource.data) || textoAte(request.resource.data.notas, 2000))
          && (!('outrasPragas' in request.resource.data) || textoAte(request.resource.data.outrasPragas, 2000));

        allow delete: if false;

        // Uma planta por documento (1 a 30). Não crie o pai e as plantas no mesmo lote:
        // get() enxerga o estado anterior ao lote.
        match /plantas/{n} {
          function pai() {
            return get(/databases/$(database)/documents/empresas/$(e)/avaliacoes/$(aid)).data;
          }

          allow read: if ehMembro(e)
            && ((dadosMembro(e).papel == 'pragueiro' && pai().responsavelUid == request.auth.uid)
                || gestaoVe(e, pai().fazendaId));

          allow create, update: if temPapel(e, ['pragueiro'])
            && pai().responsavelUid == request.auth.uid
            && pai().status == 'rascunho'
            && n.matches('^([1-9]|[12][0-9]|30)$')
            && request.resource.data.keys().hasOnly(['n', 'obs', 'fotos', 'notas', 'atualizadoEm'])
            && request.resource.data.keys().hasAll(['n', 'obs'])
            && request.resource.data.n is int
            && request.resource.data.obs is map && request.resource.data.obs.keys().size() <= 60
            && (!('fotos' in request.resource.data)
                || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 20))
            && (!('notas' in request.resource.data) || textoAte(request.resource.data.notas, 1000));

          allow delete: if false;
        }
      }

      // Decisão: o agrônomo decide uma vez por avaliação finalizada (id = id da avaliação);
      // o gerente da fazenda só marca como executada. Nada é apagado nem reescrito.
      match /decisoes/{did} {
        allow read: if gestaoVe(e, resource.data.fazendaId);
        allow create: if temPapel(e, ['agronomo']) && decisaoCriavel(e, did);
        allow update: if temPapel(e, ['gerente'])
          && veFazenda(e, resource.data.fazendaId)
          && resource.data.status == 'aprovada'
          && request.resource.data.status == 'executada'
          && request.resource.data.executadoPor == request.auth.uid
          && request.resource.data.executadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'executadoPor', 'executadoEm', 'observacaoExecucao']);
        allow delete: if false;
      }

      // Trilha de auditoria: só acrescenta. Cada um registra apenas o que ele mesmo fez.
      match /eventos/{id} {
        allow create: if ehMembro(e)
          && request.resource.data.keys().hasOnly(['uid', 'acao', 'alvo', 'em', 'detalhe'])
          && request.resource.data.keys().hasAll(['uid', 'acao', 'em'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time
          && textoAte(request.resource.data.acao, 40);
        allow read: if temPapel(e, ['admin_empresa', 'agronomo']);
        allow update, delete: if false;
      }
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
