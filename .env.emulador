# Modo emulador (npm run dev:emulador). Valores falsos: nada aqui aponta para o Firebase real.
VITE_FIREBASE_API_KEY=chave-falsa-do-emulador
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-ronda
VITE_FIREBASE_STORAGE_BUCKET=demo-ronda.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:emulador
VITE_USE_EMULATOR=true
VITE_ENABLE_PHOTO_UPLOAD=false
